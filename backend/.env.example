# 复制这个文件为.env并填入你自己的配置
# 标注【必填】的必须修改，其余的可以不修改

#——————————————————服务配置————————————————————
#后端监听端口（默认3007）
PORT=3007
#服务对外地址，用于拼接头像/图片完整URL和WebSocket地址（默认 http://127.0.0.1:3007）
SERVER_URL=http://127.0.0.1:3007
#允许跨域访问的前端地址，多个用英文逗号分隔（默认 http://localhost:5173,http://127.0.0.1:5173）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

#——————————————————数据库配置（MySQL）【这里需要注意一下】——————————————
#数据库主机（默认127.0.0.1）
DB_HOST=127.0.0.1
#数据库端口（默认3306）
DB_PORT=3306
#数据库用户名(默认root)
DB_USER=your_database_user
#数据库密码（默认空）
DB_PASSWORD=your_database_password
#数据库名（默认my-haven）
DB_NAME=your_database_name

#——————————————————鉴权配置——————————————————————————
#【必填】JWT签名密钥：一串足够长的随机字符串，用于签发/校验登录token
#生成方式（任选其一）
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# openssl rand -hex 32
JWT_SECRET=replace_with_your_own_random_secret

#B端管理接口密钥（请求头x-admin-key使用）,不配置则管理端接口一律拒绝
ADMIN_KEY=replace_with_your_admin_key

#————————————————AI模型配置————————————————————
#【必填】大模型平台申请的APIkey
AI_API_KEY=your_ai_api_key
#接口地址（OpenAI兼容的chat/completions,默认DeepSeek官方）
AI_BASE_URL=https://api.deepseek.com/v1/chat/completions
#模型名(默认deepseek-chat)
AI_MODEL=deepseek-chat
